{
  "name": "@rom4/game-engine",
  "version": "0.1.0",
  "description": "Deterministic simulation core with WebGPU rendering, physics, vehicles, audio and character controls.",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./dist/index.js",
    "./browser": "./dist/browser.js",
    "./network": "./dist/network/index.js",
    "./render-ir": "./dist/render-ir/index.js",
    "./execution": "./dist/execution/index.js",
    "./meshwork": "./dist/meshwork/index.js",
    "./content": "./dist/content/index.js",
    "./storage": "./dist/storage/index.js",
    "./world-ir": "./dist/world-ir/index.js",
    "./scene/acoustic-coupling": "./dist/scene/acoustic-coupling.js",
    "./observability": "./dist/observability/activity.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "characters": "bun run build && node tools/character-creator/server.mjs",
    "characters:bundle": "bun run build && node tools/character-creator/bundle.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.build.json && node --test test/*.test.mjs",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json && node --test test/*.test.mjs",
    "world:compile": "cargo run --manifest-path compiler/Cargo.toml -- compile",
    "world:profile": "bun run build && node tools/world-language/profile.mjs",
    "world:test": "cargo test --manifest-path compiler/Cargo.toml",
    "wave:build": "cargo build --release --target wasm32-unknown-unknown --manifest-path kernels/world-wave/Cargo.toml",
    "wave:test": "cargo test --manifest-path kernels/world-wave/Cargo.toml && bun run wave:build && bun run build && node --test test/wave-wasm.test.mjs",
    "wave:bench": "node tools/world-wave/benchmark.mjs",
    "structure:rust:build": "cargo build --release --target wasm32-unknown-unknown --manifest-path kernels/world-structure/Cargo.toml",
    "structure:rust:test": "cargo test --manifest-path kernels/world-structure/Cargo.toml && bun run structure:rust:build && bun run build && node --test test/structure-rust-wasm.test.mjs",
    "structure:rust:bench": "node tools/world-structure/benchmark.mjs",
    "rigid:rust:build": "cargo build --release --target wasm32-unknown-unknown --manifest-path kernels/world-rigid/Cargo.toml",
    "rigid:rust:test": "cargo test --manifest-path kernels/world-rigid/Cargo.toml && bun run rigid:rust:build && bun run build && node --test test/rigid-wasm.test.mjs",
    "rigid:rust:bench": "node tools/world-rigid/benchmark.mjs",
    "world:acoustics:bench": "node tools/world-acoustics/benchmark.mjs",
    "agent:proof": "bun run build && node --test test/agent-experiment.test.mjs test/agent-diagnose.test.mjs && node tools/agent/experiment.mjs examples/agent/glass.experiment.json",
    "office:demo": "bun run build && node tools/agent-office/server.mjs --demo",
    "office:live": "bun run build && node tools/agent-office/server.mjs --live",
    "office:check": "bun run build && node --test test/agent-office.test.mjs",
    "office:campus": "bun run build && node tools/agent-office/campus-server.mjs",
    "office:campus:check": "bun run build && node --test test/agent-campus.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.2"
}
