{
  "name": "@rom4/game-engine",
  "version": "0.1.0",
  "description": "Deterministic simulation core with WebGPU rendering, physics, vehicles, audio and character controls.",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./dist/index.js",
    "./browser": "./dist/browser.js",
    "./vehicles": "./dist/vehicles/index.js",
    "./vehicles/wheels": "./dist/vehicles/wheels.js",
    "./vehicles/runtime": "./dist/vehicles/vehicle.js",
    "./vehicles/scene": "./dist/vehicles/scene-vehicle.js",
    "./dsl": "./dist/dsl/index.js",
    "./dsl/runtime": "./dist/dsl/runtime.js",
    "./network": "./dist/network/index.js",
    "./examples/car-ball": "./dist/examples/car-ball.js",
    "./vehicles/arcade": "./dist/vehicles/arcade.js",
    "./project": "./dist/core/project.js",
    "./games/chess": "./dist/games/chess.js",
    "./games/chess/project": "./dist/games/chess-project.js",
    "./games/car-ball/project": "./dist/games/car-ball-project.js",
    "./games/thegame/project": "./dist/games/thegame/project.js",
    "./trace": "./dist/core/runtime-timeline.js"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.build.json && node --test test/*.test.mjs",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json && node --test test/*.test.mjs",
    "harness:vehicles": "tsc -p tsconfig.build.json && node --expose-gc tools/vehicle-domain-harness.mjs",
    "harness:vehicle-runtime": "tsc -p tsconfig.build.json && node tools/vehicle-runtime-harness.mjs",
    "harness:vehicle-scene": "tsc -p tsconfig.build.json && node tools/vehicle-scene-harness.mjs",
    "dev": "node tools/docs/dev.mjs",
    "docs:build": "tsc -p tsconfig.build.json && node tools/docs/build.mjs",
    "docs:serve": "node tools/docs/server.mjs",
    "docs:test": "tsc -p tsconfig.build.json && node --test test/dsl-playground.mjs",
    "docs:qa": "node tools/docs/qa.mjs",
    "arena": "node tools/arena.mjs",
    "cli": "bun tools/engine.mjs",
    "product:qa": "node tools/product/qa.mjs",
    "thegame": "bun tools/thegame/server.mjs",
    "thegame:qa": "node tools/thegame/qa.mjs"
  },
  "devDependencies": {"@types/node": "^24.0.0", "typescript": "^7.0.2"},
  "engines": {"node": ">=22"},
  "packageManager": "bun@1.4.2"
}
