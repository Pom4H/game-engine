{
  "name": "@rom4/game-engine",
  "version": "0.1.0",
  "description": "Deterministic simulation core with WebGPU rendering, physics, vehicles, audio and character controls.",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./dist/index.js",
    "./browser": "./dist/browser.js",
    "./network": "./dist/network/index.js",
    "./render-ir": "./dist/render-ir/index.js",
    "./execution": "./dist/execution/index.js",
    "./meshwork": "./dist/meshwork/index.js",
    "./content": "./dist/content/index.js",
    "./storage": "./dist/storage/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "characters": "bun run build && node tools/character-creator/server.mjs",
    "characters:bundle": "bun run build && node tools/character-creator/bundle.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.build.json && node --test test/*.test.mjs",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.build.json && node --test test/*.test.mjs",
    "world:compile": "cargo run --manifest-path compiler/Cargo.toml -- compile",
    "world:test": "cargo test --manifest-path compiler/Cargo.toml"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.2"
}
